# Kredensial database (dipakai oleh service db dan backend)
DB_USER=fiber_user
DB_PASSWORD=091106
DB_NAME=fiber_auth_db

# Secret untuk sign JWT — WAJIB diganti, jangan pakai contoh ini
JWT_SECRET=ganti-dengan-random-string-panjang-dan-rahasia

# URL publik API, dipakai saat build frontend.
# Karena satu domain diatur Nginx, cukup pakai path /api di domain yang sama.
PUBLIC_API_URL=https://golang.cujud.xyz/api

# URL publik frontend (untuk CORS di backend)
PUBLIC_APP_URL=https://golang.cujud.xyz
